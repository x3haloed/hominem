# Unified Theory Chat (Canonical Server) Environment Configuration

# Database Configuration
# Path to SQLite database file (will be created if it doesn't exist)
DATABASE_PATH=storage/conversations.db

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Model Configuration
# Base model (HF id or local path). Defaults to Qwen/Qwen3-1.7B
BASE_MODEL_PATH=Qwen/Qwen3-1.7B

# Optional LoRA adapter (absolute path OR name under artifacts/lora/)
AUTO_LOAD_LORA=

# Frozen head checkpoints (defaults point under artifacts/)
MANIFOLD_CKPT=
REGIME_CKPT=

# Sleep logging / optional online update
SLEEP_LOG_DIR=
SLEEP_UPDATE_ENABLED=false
SLEEP_UPDATE_CONFIG=
