TRAINING_FACTORY_DB=storage/training_factory.db
TRAINING_FACTORY_OUTPUT_ROOT=artifacts/training_factory
TRAINING_FACTORY_HOST=0.0.0.0
TRAINING_FACTORY_PORT=8010

# Labeling checkpoints (serial passes to minimize RAM)
MANIFOLD_CKPT=artifacts/manifold_bert_optimized/checkpoint-3612
REGIME_CKPT=artifacts/regime_bert_base/checkpoint-1505
REWARD_MANIFOLD_CKPT=artifacts/reward_manifold_bert_base/checkpoint-876

# Labeling behavior
TRAINING_FACTORY_LABEL_BATCH_SIZE=8
TRAINING_FACTORY_LABEL_MAX_LENGTH=512
TRAINING_FACTORY_RELABEL=false

# q_resp parameters
Q_RESP_K=0.6
Q_RESP_TAU=0.0

# MLX sleep training config
TRAINING_FACTORY_SLEEP_CONFIG=config/training/sleep_sft_update.yaml
