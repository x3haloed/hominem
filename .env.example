# Copy to .env and fill in values as needed.

# HuggingFace only
HF_TOKEN=

# Core services
HOMINEM_AGENT_HOST=0.0.0.0
HOMINEM_AGENT_PORT=8020
HOMINEM_INFER_BASE_URL=http://127.0.0.1:8000/v1
HOMINEM_AGENT_MODEL=alexgusevski/Huihui-Qwen3-VL-8B-Instruct-abliterated-q4-mlx
HOMINEM_AGENT_MODEL_TYPE=qwenvl_oai
HOMINEM_INFER_API_KEY=EMPTY
HOMINEM_UI_CORS_ORIGINS=

INFER_HOST=0.0.0.0
INFER_PORT=8000
INFER_MODEL_ID=alexgusevski/Huihui-Qwen3-VL-8B-Instruct-abliterated-q4-mlx
INFER_BACKEND=mlx_vlm
INFER_EVENT_LOG=
INFER_DEBUG_PROMPT_DUMP=
INFER_DEBUG_PROMPT_DUMP_DIR=
INFER_ALLOW_REMOTE_MEDIA=false

# YaCy search
HOMINEM_YACY_BASE_URL=http://127.0.0.1:8090
HOMINEM_YACY_TIMEOUT_S=10
HOMINEM_YACY_ALLOW_NONLOCAL=false

# Tabstack fetch
TABSTACK_API_KEY=
TABSTACK_BASE_URL=https://api.tabstack.ai/v1
TABSTACK_LOG=

# Training
HOMINEM_RUN_ID=
